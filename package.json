{
  "name": "personal-finance-coach-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run",
    "test:integration": "node scripts/run-with-test-env.mjs npx vitest run --config vitest.integration.config.ts",
    "test:e2e": "node scripts/run-with-test-env.mjs npx playwright test",
    "test:cleanup-schema": "node scripts/run-with-test-env.mjs node scripts/cleanup-postgres-test-schema.mjs",
    "security:secrets": "node scripts/check-secrets.mjs",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "ci": "npm run security:secrets && npm run security:audit && npx prisma generate && npm run lint && npm run test && npm run build && npm run test:e2e",
    "prisma:generate": "prisma generate",
    "prisma:baseline:check": "node scripts/check-postgresql-baseline.mjs",
    "prisma:baseline:deploy:test": "node scripts/run-with-test-env.mjs node scripts/deploy-postgresql-baseline.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "@prisma/client": "^6.19.3",
    "lucide-react": "^1.23.0",
    "next": "^15.5.20",
    "openai": "^6.45.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.2",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.2",
    "eslint": "^9",
    "eslint-config-next": "^15.5.20",
    "postcss": "^8.5.16",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^5",
    "vitest": "^3.2.6"
  }
}
